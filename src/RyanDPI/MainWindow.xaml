<Window x:Class="RyanDPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RyanDPI"
        Icon="pack://application:,,,/RyanDPI;component/Resources/ryandpi.ico"
        Width="580" Height="720"
        MinWidth="560" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontRegular}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54"
                      CornerRadius="12"
                      GlassFrameThickness="1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgCanvasBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Margin="18,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Lockup: Black & Neon Red DPI Shield Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="#070709"
                            BorderBrush="#99FF1E3C"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF1736" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M13,1.5 L23.5,5.5 C23.5,14 19.5,20.5 13,24.5 C6.5,20.5 2.5,14 2.5,5.5 Z"
                                  Fill="#090507"
                                  Stroke="#FF1E3C"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"/>
                            <TextBlock Text="DPI"
                                       FontFamily="{StaticResource FontBold}"
                                       FontSize="7.8"
                                       Foreground="#FF3352"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="RyanDPI"
                               FontFamily="{StaticResource FontBold}"
                               FontSize="17"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BgCardAltBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,2.5"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBrandBadge"
                                   Text="ALL APPS • FULL SPEED"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentCyanBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Region, Language, Theme & Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnRegionPicker"
                            Content="GLOBAL"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="28"
                            MinWidth="58"
                            Padding="9,0"
                            FontSize="10.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            ToolTip="Select Country / Bypass Mode (Global, Turkey, Russia, Brazil)"
                            Click="BtnRegionPicker_Click"
                            Margin="0,0,6,0"/>
                    <Button x:Name="BtnLanguageToggle"
                            Content="EN"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="28"
                            MinWidth="38"
                            Padding="10,0"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentCyanBrush}"
                            ToolTip="Choose language (EN / TR / PT-BR / RU / FA / ID / ZH / AR)"
                            Click="BtnLanguageToggle_Click"
                            Margin="0,0,6,0"/>
                    <Button x:Name="BtnThemeToggle"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Toggle Dark / Light Theme"
                            Click="BtnThemeToggle_Click"
                            Margin="0,0,4,0">
                        <Grid Width="16" Height="16">
                            <Path x:Name="IconSun"
                                  Data="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"/>
                            <Path x:Name="IconMoon"
                                  Visibility="Collapsed"
                                  Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnMinimize"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Minimize"
                            Click="BtnMinimize_Click"
                            Margin="0,0,4,0">
                        <Path Data="M4 12h16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource CloseIconButtonStyle}"
                            ToolTip="Close"
                            Click="BtnClose_Click">
                        <Path Data="M6 6l12 12M18 6L6 18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Segmented Pill Navigation -->
            <Border Grid.Row="1"
                    Margin="18,4,18,14"
                    Padding="4"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="NavHome" Content="Home" Style="{StaticResource NavTabStyle}"
                                 GroupName="MainNav" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavTabStyle}"
                                 GroupName="MainNav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTools" Content="Tools &amp; Logs" Style="{StaticResource NavTabStyle}"
                                 GroupName="MainNav" Checked="Nav_Checked"/>
                </UniformGrid>
            </Border>

            <!-- ==================== PAGE 1: HOME ==================== -->
            <ScrollViewer x:Name="PageHome" Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,0,18,18">
                <StackPanel>

                    <!-- Hero Status Card -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Status Ring + Headline -->
                            <Grid Margin="0,4,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Glowing Shield-DPI Status Emblem -->
                                <Border x:Name="StatusOrbOuter"
                                        Width="62" Height="62"
                                        CornerRadius="16"
                                        Background="#080608"
                                        BorderBrush="{DynamicResource AccentCyanBrush}"
                                        BorderThickness="1.5"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="StatusShieldGlow"
                                                          Color="#FF1E3C"
                                                          BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid Width="42" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="StatusShieldPath"
                                              Data="M21,2 L38,8.5 C38,22.5 31.5,34 21,41 C10.5,34 4,22.5 4,8.5 Z"
                                              Fill="#0B0609"
                                              Stroke="#FF1E3C"
                                              StrokeThickness="2.4"
                                              StrokeLineJoin="Round"/>
                                        <TextBlock x:Name="StatusShieldText"
                                                   Text="DPI"
                                                   FontFamily="{StaticResource FontBold}"
                                                   FontSize="12.5"
                                                   Foreground="#FF3352"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-2,0,0"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="TxtStatusHeadline"
                                               Text="Checking status..."
                                               FontFamily="{StaticResource FontBold}"
                                               FontSize="18.5"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtStatusSubtitle"
                                               Text="Scanning Windows services and encrypted DNS..."
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        x:Name="BtnRefreshStatus"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Refresh Status"
                                        VerticalAlignment="Top"
                                        Click="BtnRefreshStatus_Click">
                                    <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <!-- 3-Column Health Strip -->
                            <UniformGrid Columns="3">
                                <Border Background="{DynamicResource BgCardAltBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,9"
                                        Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtPillEngineTitle" Text="DPI ENGINE" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse x:Name="DotEngine" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtEngineState" Text="Checking" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgCardAltBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,9"
                                        Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtPillRouterTitle" Text="APP ROUTER" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse x:Name="DotRouter" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtRouterState" Text="Checking" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgCardAltBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,9"
                                        Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtPillDnsTitle" Text="SECURE DNS" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse x:Name="DotDns" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtDnsState" Text="Checking" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons Card -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Primary Hero CTA -->
                            <Button x:Name="BtnPrimaryAction"
                                    Content="Install &amp; Enable RyanDPI"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnPrimaryAction_Click"/>

                            <TextBlock x:Name="TxtActionCaption"
                                       Text="One-click install • Unlocks Roblox Studio, Roblox, Discord &amp; all blocked apps/sites automatically with zero speed loss."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="8,10,8,0"/>

                            <!-- Secondary Controls (visible once installed) -->
                            <Grid x:Name="PanelInstalledActions" Visibility="Collapsed" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        x:Name="BtnRestartEngine"
                                        Content="Reinstall / Repair"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnReinstall_Click"/>

                                <Button Grid.Column="2"
                                        x:Name="BtnQuickUninstall"
                                        Content="Uninstall"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="BtnUninstall_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Inline Live Progress Card (Hidden when idle) -->
                    <Border x:Name="PanelProgress"
                            Style="{StaticResource CardBorderStyle}"
                            Visibility="Collapsed"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TxtProgressTitle"
                                           Text="Installing RyanDPI..."
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="13.5"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" x:Name="TxtProgressStep"
                                           Text="Step 1 / 5"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentCyanBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="ProgressInstall"
                                         Style="{StaticResource ModernProgressBarStyle}"
                                         Minimum="0" Maximum="100" Value="20"/>
                            <TextBlock x:Name="TxtProgressDetail"
                                       Text="Preparing system..."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Inline Notice / Reboot Banner (Hidden by default) -->
                    <Border x:Name="PanelNotice"
                            CornerRadius="12"
                            BorderThickness="1"
                            Padding="14,12"
                            Visibility="Collapsed"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtNoticeMessage"
                                       Text=""
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button x:Name="BtnRebootNow"
                                        Content="Restart PC"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32" Padding="12,0" FontSize="12"
                                        Visibility="Collapsed"
                                        Click="BtnRebootNow_Click"
                                        Margin="0,0,6,0"/>
                                <Button Content="×"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="28" Height="28" FontSize="15"
                                        Click="BtnDismissNotice_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Connection & Unblock Self-Test Card -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelfTestTitle"
                                               Text="Unblock &amp; Speed Self-Test"
                                               FontFamily="{StaticResource FontBold}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtSelfTestSubtitle"
                                               Text="Verify Discord, Roblox App, Roblox Studio, Wattpad &amp; live ping right now."
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="BtnRunSelfTest"
                                        Content="Run Test"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34" Padding="14,0" FontSize="12"
                                        VerticalAlignment="Center"
                                        Click="BtnRunSelfTest_Click"/>
                            </Grid>

                            <ItemsControl x:Name="ListSelfTestResults">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgCardAltBrush}"
                                                CornerRadius="8"
                                                Padding="10,7"
                                                Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        Background="{Binding StatusBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding LatencyText}"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtSelfTestPlaceholder"
                                       Text="Click 'Run Test' to verify live access and response latency."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="2,2,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PAGE 2: SETTINGS ==================== -->
            <Grid x:Name="PageSettings" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="18,0,18,12">
                    <StackPanel>

                        <!-- Country / Region Mode -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtRegionSectionTitle"
                                           Text="Country / Region Mode"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbRegion"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="CmbRegion_SelectionChanged">
                                    <ComboBoxItem x:Name="ItemRegionGlobal" Content="Universal Global (Recommended)" Tag="GlobalUniversal"/>
                                    <ComboBoxItem x:Name="ItemRegionTurkey" Content="Turkey — BTK Zero-Lag" Tag="Turkey"/>
                                    <ComboBoxItem x:Name="ItemRegionRussia" Content="Russia — TSPU Full Unblock" Tag="Russia"/>
                                    <ComboBoxItem x:Name="ItemRegionBrazil" Content="Brazil — Discord Screen Share &amp; Video" Tag="Brazil"/>
                                </ComboBox>

                                <TextBlock x:Name="TxtRegionDescription"
                                           Text="7-stage zero-lag DPI engine that auto-adapts across Turkey, Russia &amp; worldwide ISPs."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Brazil Discord-Only Split-Tunnel Card -->
                        <Border x:Name="CardBrazilSplitTunnel" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtBrazilSectionTitle"
                                           Text="Brazil Discord Split-Tunnel (0ms Game Lag)"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentCyanBrush}"
                                           Margin="0,0,0,6"/>

                                <TextBlock x:Name="TxtBrazilNotice"
                                           Text="Discord disabled Screen Share &amp; Video in Brazil by Geo-IP (ANPD order), not ISP DPI. RyanDPI routes ONLY Discord while leaving all games 100% direct!"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <ComboBox x:Name="CmbBrazilTunnel"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="CmbBrazilTunnel_SelectionChanged">
                                    <ComboBoxItem x:Name="ItemBrazilWarp" Content="Built-in Free Cloudflare WARP MASQUE (Zero Login)" Tag="BuiltInWarpMasque"/>
                                    <ComboBoxItem x:Name="ItemBrazilCustom" Content="Custom Non-Brazil SOCKS5 Proxy (US / AR / EU — Guaranteed Non-BR IP)" Tag="CustomSocks5"/>
                                </ComboBox>

                                <StackPanel x:Name="PanelCustomSocks" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock x:Name="TxtCustomSocksEndpointLabel"
                                               Text="Non-Brazil SOCKS5 Endpoint (host:port):"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtCustomSocksEndpoint"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Height="34"
                                             Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtCustomSocksUserLabel"
                                                       Text="Username (optional):"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtCustomSocksUser"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     FontSize="12"
                                                     Height="34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="TxtCustomSocksPassLabel"
                                                       Text="Password (optional):"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtCustomSocksPass"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     FontSize="12"
                                                     Height="34"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,12,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtBrazilUdpTitle" Text="Route Discord UDP (Go Live Video &amp; Voice)" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtBrazilUdpDesc" Text="ON routes full Discord TCP+UDP. Turn OFF for API-only unlock (direct local UDP voice/video)."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkBrazilIncludeUdp" Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtBrazilBrowsersTitle" Text="Also Route Web Browsers (Discord Web)" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtBrazilBrowsersDesc" Text="Include Chrome, Edge, Firefox, Brave &amp; Opera if you screen share in browser."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkBrazilIncludeBrowsers" Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bypass Profile -->
                        <Border x:Name="CardDpiProfile" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtProfileSectionTitle"
                                           Text="DPI Bypass Profile"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbProfile"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="CmbProfile_SelectionChanged">
                                    <ComboBoxItem x:Name="ItemProfileAuto" Content="Auto Universal (7-Stage — Other Countries)" Tag="AutoUniversal"/>
                                    <ComboBoxItem x:Name="ItemProfileTurkey" Content="Turkey BTK (Ultra-Lean 3-Stage — Lowest Latency)" Tag="TurkeyBtk"/>
                                    <ComboBoxItem x:Name="ItemProfileRussia" Content="Russia TSPU (YouTube, Discord, Instagram — First Packet)" Tag="RussiaTspu"/>
                                    <ComboBoxItem x:Name="ItemProfileClassic" Content="Classic Mode (Lightweight TLS Record Split)" Tag="ClassicByeDpi"/>
                                    <ComboBoxItem x:Name="ItemProfileStrict" Content="Strict ISP (Superonline / Mobile / Aggressive DPI)" Tag="StrictIsp"/>
                                    <ComboBoxItem x:Name="ItemProfileCustom" Content="Custom Arguments" Tag="Custom"/>
                                </ComboBox>

                                <TextBlock x:Name="TxtProfileDescription"
                                           Text="Automatically adapts across 6 proven desync strategies with 128 KB full-speed buffers and 24-hour per-IP caching."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>

                                <StackPanel x:Name="PanelCustomArgs" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock x:Name="TxtCustomArgsLabel"
                                               Text="Custom ciadpi.exe strategy arguments:"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtCustomArgs"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             FontFamily="Consolas"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             Height="62"
                                             VerticalContentAlignment="Top"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- DNS Protection -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtDnsSectionTitle"
                                           Text="DNS Protection"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbDnsMode"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="CmbDnsMode_SelectionChanged">
                                    <ComboBoxItem x:Name="ItemDnsEncrypted" Content="Encrypted DNS — DNSCrypt-Proxy (Recommended)" Tag="EncryptedDnsProxy"/>
                                    <ComboBoxItem x:Name="ItemDnsNativeDoH" Content="Windows Native DoH (Google + Quad9)" Tag="WindowsNativeDoH"/>
                                    <ComboBoxItem x:Name="ItemDnsKeepSystem" Content="Keep My Existing DNS Settings" Tag="KeepSystemDns"/>
                                </ComboBox>

                                <TextBlock x:Name="TxtDnsDescription"
                                           Text="Runs local encrypted DNS (DNSCrypt-Proxy) via Cloudflare, Google &amp; Quad9 (fastest-first) with an 8,192-entry cache. Eliminates ISP DNS poisoning on Windows 10 &amp; 11."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Speed & Network Switches -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtNetworkSectionTitle"
                                           Text="Network &amp; Speed Options"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtBypassLanTitle" Text="Bypass LAN &amp; Localhost" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtBypassLanDesc" Text="Keep local devices, routers, and localhost dev servers completely direct."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkBypassLan" Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtTunnelUdpTitle" Text="Also Tunnel UDP (Voice / QUIC)" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtTunnelUdpDesc" Text="Keep OFF for 0ms native gaming ping. Turn ON only if your ISP blocks Discord voice or QUIC."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkTunnelUdp" Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtAutoUpdateTitle" Text="Auto-Update on Startup" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtAutoUpdateDesc" Text="Automatically download, verify, and install new RyanDPI releases when the app opens."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkAutoUpdate" Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Excluded Apps -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock x:Name="TxtExcludesSectionTitle"
                                           Text="Excluded Apps (Optional)"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtExcludesDesc"
                                           Text="RyanDPI unlocks every app on Windows by default. Only add apps here if you want them to skip RyanDPI. Engine and DNS processes are always excluded automatically."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtExcludeInput"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Height="36"
                                             KeyDown="TxtExcludeInput_KeyDown"
                                             ToolTip="Enter an executable name (e.g. game.exe)"/>
                                    <Button Grid.Column="2" x:Name="BtnAddExclude" Content="Add"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36" Padding="14,0"
                                            Click="BtnAddExclude_Click"/>
                                    <Button Grid.Column="4" x:Name="BtnBrowseExclude" Content="Browse..."
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36" Padding="12,0"
                                            Click="BtnBrowseExclude_Click"/>
                                </Grid>

                                <ItemsControl x:Name="ListExcludes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCardAltBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="×"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Width="24" Height="24" FontSize="14"
                                                            Click="BtnRemoveExclude_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="TxtNoExcludes"
                                           Text="No custom app exclusions configured — all user apps are unlocked."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky Save Bar -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="18,12">
                    <Button x:Name="BtnSaveApplySettings"
                            Content="Save &amp; Apply Settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            Click="BtnSaveApplySettings_Click"/>
                </Border>
            </Grid>

            <!-- ==================== PAGE 3: TOOLS & LOGS ==================== -->
            <Grid x:Name="PageTools" Grid.Row="2" Visibility="Collapsed" Margin="18,0,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Quick System Maintenance Actions -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtToolsSectionTitle"
                                   Text="System Tools"
                                   FontFamily="{StaticResource FontBold}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,10"/>

                        <UniformGrid Columns="2">
                            <Button x:Name="BtnResetDns"
                                    Content="Reset DNS &amp; Flush Cache"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,5,8"
                                    Click="BtnResetDns_Click"/>
                            <Button x:Name="BtnCleanLegacy"
                                    Content="Clean Legacy DPI Services"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="5,0,0,8"
                                    Click="BtnCleanLegacy_Click"/>
                            <Button x:Name="BtnOpenLogs"
                                    Content="Open Logs Folder"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,5,0"
                                    Click="BtnOpenLogs_Click"/>
                            <Button x:Name="BtnToolsUninstall"
                                    Content="Uninstall RyanDPI"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="5,0,0,0"
                                    Click="BtnUninstall_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Live Activity Log Viewer -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TxtLogsSectionTitle"
                                       Text="Live Activity Log"
                                       FontFamily="{StaticResource FontBold}"
                                       FontSize="14"
                                       Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnCopyLogs"
                                        Content="Copy"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="28" Padding="12,0" FontSize="11.5"
                                        Margin="0,0,6,0"
                                        Click="BtnCopyLogs_Click"/>
                                <Button x:Name="BtnClearLogs"
                                        Content="Clear"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="28" Padding="12,0" FontSize="11.5"
                                        Click="BtnClearLogs_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource BgInputBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8">
                            <TextBox x:Name="TxtLogs"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- About & Updates Footer -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtAboutVersion"
                                       Text="RyanDPI v3.1.3 Unbound — Global Zero-Lag DPI Bypass &amp; Split-Tunnel"
                                       FontFamily="{StaticResource FontBold}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtAboutSubtitle"
                                       Text="Turkey • Russia • Brazil • Worldwide. Built with ByeDPI, ProxiFyre, DNSCrypt-Proxy &amp; Usque WARP MASQUE."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="BtnCheckUpdates"
                                Content="Check Updates"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Padding="12,0" FontSize="11.5"
                                VerticalAlignment="Center"
                                Click="BtnCheckUpdates_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== FIRST-STARTUP / COUNTRY PICKER OVERLAY ==================== -->
            <Border x:Name="OverlayRegionPicker"
                    Grid.Row="0" Grid.RowSpan="3"
                    Background="#E6060608"
                    Visibility="Collapsed"
                    Padding="24">
                <Border Style="{StaticResource CardBorderStyle}"
                        BorderBrush="{DynamicResource AccentCyanBrush}"
                        BorderThickness="1.2"
                        VerticalAlignment="Center"
                        Padding="22">
                    <StackPanel>
                        <TextBlock x:Name="TxtRegionPickerTitle"
                                   Text="Choose Your Region Mode"
                                   FontFamily="{StaticResource FontBold}"
                                   FontSize="19"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtRegionPickerSubtitle"
                                   Text="Select your country for instant zero-lag defaults, or use Universal Global across all DPI-censored ISPs."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,16"/>

                        <Button x:Name="BtnPickGlobal" Tag="GlobalUniversal" Click="BtnPickRegion_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalContentAlignment="Stretch" Height="Auto" Padding="14,11" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock x:Name="TxtPickGlobalTitle" Text="Universal Global (Recommended)" FontFamily="{StaticResource FontBold}" FontSize="13.5" Foreground="{DynamicResource AccentCyanBrush}"/>
                                <TextBlock x:Name="TxtPickGlobalDesc" Text="7-stage zero-lag DPI engine that auto-adapts across Turkey, Russia &amp; worldwide ISPs with 24h per-IP caching." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPickTurkey" Tag="Turkey" Click="BtnPickRegion_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalContentAlignment="Stretch" Height="Auto" Padding="14,11" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock x:Name="TxtPickTurkeyTitle" Text="Turkey — BTK Zero-Lag" FontFamily="{StaticResource FontBold}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtPickTurkeyDesc" Text="Unlocks Discord, Roblox, Roblox Studio &amp; Wattpad at full speed. UDP stays direct for 0ms gaming ping." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPickRussia" Tag="Russia" Click="BtnPickRegion_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalContentAlignment="Stretch" Height="Auto" Padding="14,11" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock x:Name="TxtPickRussiaTitle" Text="Russia — TSPU Full Unblock" FontFamily="{StaticResource FontBold}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtPickRussiaDesc" Text="TSPU-first split/disorder/fake-SNI chain + UDP voice bypass for YouTube, Discord, Instagram &amp; Roblox." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPickBrazil" Tag="Brazil" Click="BtnPickRegion_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalContentAlignment="Stretch" Height="Auto" Padding="14,11" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtPickBrazilTitle" Text="Brazil — Discord Screen Share &amp; Video" FontFamily="{StaticResource FontBold}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtPickBrazilDesc" Text="ANPD Geo-IP unlock: tunnels ONLY Discord (0ms lag in games!) via built-in WARP MASQUE or Custom SOCKS5." FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCloseRegionPicker"
                                Content="Continue"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="38"
                                Click="BtnCloseRegionPicker_Click"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ==================== 8-LANGUAGE PICKER OVERLAY ==================== -->
            <Border x:Name="OverlayLanguagePicker"
                    Grid.Row="0" Grid.RowSpan="3"
                    Background="#E6060608"
                    Visibility="Collapsed"
                    Padding="24">
                <Border Style="{StaticResource CardBorderStyle}"
                        BorderBrush="{DynamicResource AccentCyanBrush}"
                        BorderThickness="1.2"
                        VerticalAlignment="Center"
                        Padding="22">
                    <StackPanel>
                        <TextBlock x:Name="TxtLangPickerTitle"
                                   Text="Choose Language"
                                   FontFamily="{StaticResource FontBold}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtLangPickerSubtitle"
                                   Text="RyanDPI Unbound supports 8 languages worldwide."
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,14"/>

                        <UniformGrid x:Name="GridLanguageOptions" Columns="2" Margin="0,0,0,12"/>

                        <Button x:Name="BtnCloseLanguagePicker"
                                Content="Close"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="36"
                                Click="BtnCloseLanguagePicker_Click"/>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </Border>
</Window>
