<Window x:Class="RyanDPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RyanDPI"
        Icon="pack://application:,,,/RyanDPI;component/Resources/ryandpi.ico"
        Width="560" Height="700"
        MinWidth="540" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontRegular}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54"
                      CornerRadius="12"
                      GlassFrameThickness="1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgCanvasBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Margin="18,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Lockup -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource BrandGradientBrush}" Margin="0,0,10,0">
                        <Path Data="M13 2L4 14h7l-1 8 9-12h-7l1-8z"
                              Fill="White"
                              Stretch="Uniform"
                              Width="15" Height="15"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RyanDPI"
                               FontFamily="{StaticResource FontBold}"
                               FontSize="17"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BgCardAltBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="ALL APPS • FULL SPEED"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentCyanBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Theme & Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnThemeToggle"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Toggle Dark / Light Theme"
                            Click="BtnThemeToggle_Click"
                            Margin="0,0,4,0">
                        <Grid Width="16" Height="16">
                            <Path x:Name="IconSun"
                                  Data="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"/>
                            <Path x:Name="IconMoon"
                                  Visibility="Collapsed"
                                  Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Minimize"
                            Click="BtnMinimize_Click"
                            Margin="0,0,4,0">
                        <Path Data="M4 12h16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource CloseIconButtonStyle}"
                            ToolTip="Close"
                            Click="BtnClose_Click">
                        <Path Data="M6 6l12 12M18 6L6 18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Segmented Pill Navigation -->
            <Border Grid.Row="1"
                    Margin="18,4,18,14"
                    Padding="4"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="NavHome" Content="Home" Style="{StaticResource NavTabStyle}"
                                 GroupName="MainNav" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavTabStyle}"
                                 GroupName="MainNav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTools" Content="Tools &amp; Logs" Style="{StaticResource NavTabStyle}"
                                 GroupName="MainNav" Checked="Nav_Checked"/>
                </UniformGrid>
            </Border>

            <!-- ==================== PAGE 1: HOME ==================== -->
            <ScrollViewer x:Name="PageHome" Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,0,18,18">
                <StackPanel>

                    <!-- Hero Status Card -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Status Ring + Headline -->
                            <Grid Margin="0,4,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Glowing Status Orb -->
                                <Border x:Name="StatusOrbOuter"
                                        Width="58" Height="58"
                                        CornerRadius="29"
                                        Background="{DynamicResource BgCardAltBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="2"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <Path x:Name="StatusOrbIcon"
                                          Data="M13 2L4 14h7l-1 8 9-12h-7l1-8z"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Stretch="Uniform"
                                          Width="24" Height="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStatusHeadline"
                                               Text="Checking status..."
                                               FontFamily="{StaticResource FontBold}"
                                               FontSize="19"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtStatusSubtitle"
                                               Text="Scanning Windows services and encrypted DNS..."
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        x:Name="BtnRefreshStatus"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Refresh Status"
                                        VerticalAlignment="Top"
                                        Click="BtnRefreshStatus_Click">
                                    <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <!-- 3-Column Health Strip -->
                            <UniformGrid Columns="3">
                                <Border Background="{DynamicResource BgCardAltBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,9"
                                        Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="DPI ENGINE" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse x:Name="DotEngine" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtEngineState" Text="Checking" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgCardAltBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,9"
                                        Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="APP ROUTER" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse x:Name="DotRouter" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtRouterState" Text="Checking" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgCardAltBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,9"
                                        Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SECURE DNS" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse x:Name="DotDns" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtDnsState" Text="Checking" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons Card -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Primary Hero CTA -->
                            <Button x:Name="BtnPrimaryAction"
                                    Content="Install &amp; Enable RyanDPI"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnPrimaryAction_Click"/>

                            <TextBlock x:Name="TxtActionCaption"
                                       Text="One-click install • Unlocks Roblox Studio, Roblox, Discord &amp; all blocked apps/sites automatically with zero speed loss."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="8,10,8,0"/>

                            <!-- Secondary Controls (visible once installed) -->
                            <Grid x:Name="PanelInstalledActions" Visibility="Collapsed" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        x:Name="BtnRestartEngine"
                                        Content="Reinstall / Repair"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnReinstall_Click"/>

                                <Button Grid.Column="2"
                                        x:Name="BtnQuickUninstall"
                                        Content="Uninstall"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="BtnUninstall_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Inline Live Progress Card (Hidden when idle) -->
                    <Border x:Name="PanelProgress"
                            Style="{StaticResource CardBorderStyle}"
                            Visibility="Collapsed"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="TxtProgressTitle"
                                           Text="Installing RyanDPI..."
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtProgressStep"
                                           Text="Step 1 / 5"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentCyanBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="ProgressInstall"
                                         Style="{StaticResource ModernProgressBarStyle}"
                                         Minimum="0" Maximum="100" Value="20"/>
                            <TextBlock x:Name="TxtProgressDetail"
                                       Text="Preparing system..."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Inline Notice / Reboot Banner (Hidden by default) -->
                    <Border x:Name="PanelNotice"
                            CornerRadius="12"
                            BorderThickness="1"
                            Padding="14,12"
                            Visibility="Collapsed"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtNoticeMessage"
                                       Text=""
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button x:Name="BtnRebootNow"
                                        Content="Restart PC"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32" Padding="12,0" FontSize="12"
                                        Visibility="Collapsed"
                                        Click="BtnRebootNow_Click"
                                        Margin="0,0,6,0"/>
                                <Button Content="×"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="28" Height="28" FontSize="15"
                                        Click="BtnDismissNotice_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Connection & Unblock Self-Test Card -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Unblock &amp; Speed Self-Test"
                                               FontFamily="{StaticResource FontBold}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Verify Discord, Roblox, Roblox Studio API &amp; direct latency right now."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnRunSelfTest"
                                        Content="Run Test"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34" Padding="14,0" FontSize="12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="BtnRunSelfTest_Click"/>
                            </Grid>

                            <ItemsControl x:Name="ListSelfTestResults">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgCardAltBrush}"
                                                CornerRadius="8"
                                                Padding="10,7"
                                                Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        Background="{Binding StatusBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding LatencyText}"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtSelfTestPlaceholder"
                                       Text="Click 'Run Test' to verify live access and response latency."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="2,2,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PAGE 2: SETTINGS ==================== -->
            <Grid x:Name="PageSettings" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="18,0,18,12">
                    <StackPanel>

                        <!-- Bypass Profile -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="DPI Bypass Profile"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbProfile"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="CmbProfile_SelectionChanged">
                                    <ComboBoxItem Content="Auto Universal (Recommended — All Turkish ISPs)" Tag="AutoUniversal"/>
                                    <ComboBoxItem Content="Classic Mode (Lightweight Split + Disorder)" Tag="ClassicByeDpi"/>
                                    <ComboBoxItem Content="Strict ISP (Superonline / Mobile / Aggressive DPI)" Tag="StrictIsp"/>
                                    <ComboBoxItem Content="Custom Arguments" Tag="Custom"/>
                                </ComboBox>

                                <TextBlock x:Name="TxtProfileDescription"
                                           Text="Automatically adapts across 6 proven desync strategies with 128 KB full-speed buffers and 24-hour per-IP caching."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>

                                <StackPanel x:Name="PanelCustomArgs" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="Custom ciadpi.exe strategy arguments:"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtCustomArgs"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             FontFamily="Consolas"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             Height="62"
                                             VerticalContentAlignment="Top"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- DNS Protection -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="DNS Protection"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbDnsMode"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="CmbDnsMode_SelectionChanged">
                                    <ComboBoxItem Content="Encrypted DNS — DNSCrypt-Proxy (Recommended)" Tag="EncryptedDnsProxy"/>
                                    <ComboBoxItem Content="Windows Native DoH (Google + Quad9)" Tag="WindowsNativeDoH"/>
                                    <ComboBoxItem Content="Keep My Existing DNS Settings" Tag="KeepSystemDns"/>
                                </ComboBox>

                                <TextBlock x:Name="TxtDnsDescription"
                                           Text="Encrypts all DNS lookups via Google, Cloudflare, and Quad9 with a local cache. Eliminates ISP DNS poisoning on both Windows 10 and 11."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Speed & Network Switches -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Network &amp; Speed Options"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Bypass LAN &amp; Localhost" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Keep local devices, routers, and localhost dev servers completely direct."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkBypassLan" Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Also Tunnel UDP (Voice / QUIC)" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Keep OFF for 0ms native gaming ping. Turn ON only if your ISP blocks Discord voice or QUIC."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkTunnelUdp" Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Excluded Apps -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Excluded Apps (Optional)"
                                           FontFamily="{StaticResource FontBold}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="RyanDPI unlocks every app on Windows by default. Only add apps here if you want them to skip RyanDPI. Engine and DNS processes are always excluded automatically."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtExcludeInput"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Height="36"
                                             KeyDown="TxtExcludeInput_KeyDown"
                                             ToolTip="Enter an executable name (e.g. game.exe)"/>
                                    <Button Grid.Column="2" Content="Add"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36" Padding="14,0"
                                            Click="BtnAddExclude_Click"/>
                                    <Button Grid.Column="4" Content="Browse..."
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36" Padding="12,0"
                                            Click="BtnBrowseExclude_Click"/>
                                </Grid>

                                <ItemsControl x:Name="ListExcludes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCardAltBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,2">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Content="×"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Width="24" Height="24" FontSize="14"
                                                            HorizontalAlignment="Right"
                                                            Click="BtnRemoveExclude_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="TxtNoExcludes"
                                           Text="No custom app exclusions configured — all user apps are unlocked."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky Save Bar -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="18,12">
                    <Button x:Name="BtnSaveApplySettings"
                            Content="Save &amp; Apply Settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            Click="BtnSaveApplySettings_Click"/>
                </Border>
            </Grid>

            <!-- ==================== PAGE 3: TOOLS & LOGS ==================== -->
            <Grid x:Name="PageTools" Grid.Row="2" Visibility="Collapsed" Margin="18,0,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Quick System Maintenance Actions -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="System Tools"
                                   FontFamily="{StaticResource FontBold}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,10"/>

                        <UniformGrid Columns="2">
                            <Button x:Name="BtnResetDns"
                                    Content="Reset DNS &amp; Flush Cache"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,5,8"
                                    Click="BtnResetDns_Click"/>
                            <Button x:Name="BtnCleanLegacy"
                                    Content="Clean Legacy DPI Services"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="5,0,0,8"
                                    Click="BtnCleanLegacy_Click"/>
                            <Button Content="Open Logs Folder"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,5,0"
                                    Click="BtnOpenLogs_Click"/>
                            <Button x:Name="BtnToolsUninstall"
                                    Content="Uninstall RyanDPI"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="5,0,0,0"
                                    Click="BtnUninstall_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Live Activity Log Viewer -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Live Activity Log"
                                       FontFamily="{StaticResource FontBold}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Copy"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="28" Padding="12,0" FontSize="11.5"
                                        Margin="0,0,6,0"
                                        Click="BtnCopyLogs_Click"/>
                                <Button Content="Clear"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="28" Padding="12,0" FontSize="11.5"
                                        Click="BtnClearLogs_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource BgInputBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8">
                            <TextBox x:Name="TxtLogs"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- About Footer -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="RyanDPI v2.0.0 — System-Wide Zero-Speed-Loss DPI Bypass"
                                   FontFamily="{StaticResource FontBold}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="100% local DPI desynchronization (no remote VPN servers). Built with ByeDPI, ProxiFyre &amp; DNSCrypt-Proxy for zero-speed-loss system-wide unblocking."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
